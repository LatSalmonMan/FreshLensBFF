# FreshLens BFF — recipe search API for TrueNAS / Docker
#
# Dev / local: copy to .env and use docker-compose.yml
# TrueNAS UI: use truenas-compose.yaml (Install via YAML) instead

HOST_DATA_DIR=./data
HOST_PGDATA_DIR=./pgdata
API_PORT=3080

POSTGRES_USER=freshlens
POSTGRES_PASSWORD=freshlens
POSTGRES_DB=recipes
RECIPES_CSV=/data/full_dataset.csv.gz

# Optional: require X-FreshLens-Key on /recipes and /products (leave blank for open LAN)
FRESHLENS_API_KEY=

# Published image (docker-compose pulls this when not building)
# IMAGE=ghcr.io/latsalmonman/freshlens-bff:latest
