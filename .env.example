# Copy to .env on the TrueNAS host (next to docker-compose.yml) and edit paths.

# Dataset with full_dataset.csv or full_dataset.csv.gz
HOST_DATA_DIR=/mnt/SwimmingPool/lstsalmonman/FreshLens-Recipe-Dataset/data

# Empty folder for Postgres files (create once; do not put CSV here)
HOST_PGDATA_DIR=/mnt/SwimmingPool/lstsalmonman/FreshLens-Recipe-Dataset/pgdata

API_PORT=3080

POSTGRES_USER=freshlens
POSTGRES_PASSWORD=freshlens
POSTGRES_DB=recipes

# Path inside the importer container
RECIPES_CSV=/data/full_dataset.csv.gz

# Optional Postgres tuning (raise if NAS has lots of free RAM)
# PG_SHARED_BUFFERS=1GB
# PG_EFFECTIVE_CACHE=4GB
# PG_MAINTENANCE_MEM=768MB
